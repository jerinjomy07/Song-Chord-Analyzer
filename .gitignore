# ==========================================
# Song Chord Analyzer - Git Ignore
# ==========================================

# Node & Frontend dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Build and distribution directories
dist/
dist_electron/
out/
release/
frontend/dist/
frontend/build/

# Packaging outputs
*.exe
*.dmg
*.AppImage
*.deb
*.zip

# Static heavy binaries
resources/ffmpeg/*.exe

# Python Virtual Environments
venv/
.venv/
env/
ENV/
python-runtime/
python-build-standalone/

# Python compiled bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.pytest_cache/

# Audio files, uploaded songs, separated stems, and local cache
storage/uploads/*
!storage/uploads/.gitkeep
storage/stems/*
!storage/stems/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
storage/exports/*
!storage/exports/.gitkeep
storage/temp/*
!storage/temp/.gitkeep

# Large ML Weights & Checkpoints (downloaded on demand)
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
checkpoints/

# Extras & Large static binaries
extras/
resources/ffmpeg/*.zip
resources/ffmpeg/*.7z

# Logs and system artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS metadata
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Environment variables & editor settings
.env
.env.local
.env.*.local
.vscode/
.idea/
*.swp
*.swo
